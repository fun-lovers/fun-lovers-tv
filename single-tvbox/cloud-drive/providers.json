{
  "name": "single-tvbox-cloud-drive-providers",
  "version": 1,
  "backend": "AList-TvBox",
  "backend_project": "https://github.com/power721/alist-tvbox",
  "subscription_mode": "separate_tvbox_subscription",
  "credential_policy": "never_commit_credentials",
  "providers": [
    {
      "id": "aliyun",
      "name": "阿里云盘",
      "auth": "Token",
      "share_links": true
    },
    {
      "id": "baidu",
      "name": "百度网盘",
      "auth": "account_or_share",
      "share_links": true
    },
    {
      "id": "quark",
      "name": "夸克网盘",
      "auth": "Cookie",
      "share_links": true
    },
    {
      "id": "uc",
      "name": "UC网盘",
      "auth": "Cookie",
      "share_links": true
    },
    {
      "id": "115",
      "name": "115网盘",
      "auth": "Cookie",
      "share_links": true
    },
    {
      "id": "123",
      "name": "123网盘",
      "auth": "account_or_share",
      "share_links": true
    },
    {
      "id": "tianyi",
      "name": "天翼云盘",
      "auth": "account_or_share",
      "share_links": true
    },
    {
      "id": "139",
      "name": "中国移动云盘",
      "auth": "account_or_share",
      "share_links": true
    },
    {
      "id": "thunder",
      "name": "迅雷云盘",
      "auth": "account_or_share",
      "share_links": true
    },
    {
      "id": "pikpak",
      "name": "PikPak",
      "auth": "account_or_share",
      "share_links": true
    },
    {
      "id": "guangya",
      "name": "光鸭云盘",
      "auth": "account_or_share",
      "share_links": true
    }
  ],
  "limitations": [
    "Provider support is based on upstream AList-TvBox documentation, not independent playback certification.",
    "Availability depends on provider driver, account permissions, region, rate limits and TVBox client compatibility.",
    "Only access files and shares the user is authorized to use."
  ]
}
